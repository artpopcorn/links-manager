// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Главная родительская рубрика
model ParentCategory {
  id          String   @id @default(cuid())
  title       String
  description String?
  slug        String   @unique
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Связь с дочерними рубриками
  childCategories ChildCategory[]

  @@map("parent_categories")
}

// Дочерняя рубрика
model ChildCategory {
  id          String   @id @default(cuid())
  title       String
  description String?
  slug        String   @unique
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Связь с родительской рубрикой
  parentId       String
  parentCategory ParentCategory @relation(fields: [parentId], references: [id], onDelete: Cascade)

  // Связь с записями/ссылками
  links Link[]

  @@map("child_categories")
}

// Записи/ссылки
model Link {
  id          String   @id @default(cuid())
  title       String
  url         String
  description String?
  image       String?  // URL картинки
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Связь с дочерней рубрикой
  categoryId    String
  childCategory ChildCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("links")
}