# Production Environment Variables для links.saidd.ru

# Database - PostgreSQL на VDS
# Замените на реальные данные вашего сервера
DATABASE_URL="postgresql://links_user:ЗАМЕНИТЕ_НА_СИЛЬНЫЙ_ПАРОЛЬ@localhost:5432/links_manager?schema=public"

# NextAuth.js
NEXTAUTH_URL="https://links.saidd.ru"
NEXTAUTH_SECRET="СГЕНЕРИРУЙТЕ_СЛУЧАЙНЫЙ_СЕКРЕТ_32_СИМВОЛА_МИНИМУМ"

# JWT - используйте ДРУГОЙ секрет, не такой же как NEXTAUTH_SECRET!
JWT_SECRET="СГЕНЕРИРУЙТЕ_ДРУГОЙ_СЛУЧАЙНЫЙ_СЕКРЕТ_32_СИМВОЛА"

# Генерация секретов:
# Выполните на сервере: openssl rand -base64 32
